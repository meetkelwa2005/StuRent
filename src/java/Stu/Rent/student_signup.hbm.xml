<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="Stu.Rent">
<class name="student_signup" table="student_signup">
    <id name="id" column="id"/>
    <property name="password" column="password"/>
    <property name="fullname" column="fullname"/>
     <property name="adhar" column="adhar"/>
     <property name="photo" column="photo"/>
    <property name="gender" column=" gender"/>
   <property name="contact" column="contact"/>
    <property name="mailid" column="mailid"/>
    <property name="city" column="city"/>
    <property name="DOB" column="DOB"/>
</class>
</hibernate-mapping>

         



