<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="Stu.Rent">
<class name="Orderproduct" table="orderproduct_table">
    <id name="order_id" column="order_id">
            <generator class="native"/>
        </id>
    <property name="Student_id" column="Student_id"/>
    <property name="productname" column="productname"/>
    <property name="quantity" column="quantity"/>
    <property name="price" column="price"/>
    <property name="address" column="address"/>
    <property name="city" column="city"/>
    <property name="contact" column="contact"/>
</class>
</hibernate-mapping>

